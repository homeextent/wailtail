{
  "functions": {
    "api/router.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:endpoint*",
      "destination": "/api/router?__endpoint=:endpoint*"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/((?!api(?:/|$)|privacy-policy(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
