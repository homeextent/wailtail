rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true) &&
        (request.auth.token.email.lower() == 'jeremygoodmurphy@gmail.com' ||
         request.auth.token.email.lower() == 'jeremy@theinnovativegroup.ca');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTokenEmailVerified() {
      return isAuthenticated() &&
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true);
    }

    // Auctions & Media Subcollections
    match /auctions/{auctionId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        (!request.resource.data.keys().hasAny(['sellerType', 'dealerId', 'dealerSnapshot', 'dealerDocFee', 'taxHandling', 'taxDisclaimerVersion']) || isAdmin());
      allow update: if isAuthenticated() && 
        (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerType', 'dealerId', 'dealerSnapshot', 'dealerDocFee', 'taxHandling', 'taxDisclaimerVersion']));
      allow delete: if isAuthenticated();

      match /{document=**} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated();
      }
    }

    // Bids & Bidding Telemetry
    match /bids/{bidId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Comments & Community Q&A
    match /comments/{commentId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // User Accounts & Moderation Registry
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('dealerId' in request.resource.data)) &&
        (!('isBanned' in request.resource.data)) &&
        (!('bannedFromBidding' in request.resource.data)) &&
        (!('bannedAt' in request.resource.data)) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'bidder') &&
        (!('isEmailVerified' in request.resource.data) || request.resource.data.isEmailVerified == false || isTokenEmailVerified())
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'dealerId',
          'isBanned',
          'bannedFromBidding',
          'bannedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isEmailVerified']) ||
         request.resource.data.isEmailVerified == false ||
         isTokenEmailVerified())
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /bidders/{bidderId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(bidderId) &&
        (!('dealerId' in request.resource.data)) &&
        (!('isBanned' in request.resource.data)) &&
        (!('bannedFromBidding' in request.resource.data)) &&
        (!('bannedAt' in request.resource.data)) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'bidder') &&
        (!('isEmailVerified' in request.resource.data) || request.resource.data.isEmailVerified == false || isTokenEmailVerified())
      );
      allow update: if isAdmin() || (
        isOwner(bidderId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'dealerId',
          'isBanned',
          'bannedFromBidding',
          'bannedAt'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isEmailVerified']) ||
         request.resource.data.isEmailVerified == false ||
         isTokenEmailVerified())
      );
      allow delete: if isOwner(bidderId) || isAdmin();
    }

    // Dealer Profiles (Private Canonical Records)
    match /dealer_profiles/{dealerId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Dealer Verification Audits (Append-only Administrative History)
    match /dealer_verification_audits/{auditId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Platform Settings & Media Configuration
    match /settings/promotions {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Promo Analytics & Click Telemetry
    match /promo_analytics/{promoId} {
      allow read: if true;
      allow create, update: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /mediaConfig/{configId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    match /media/{docId} {
      allow read: if true;
      allow write, create, update, delete: if isAuthenticated();
    }

    // Intake Forms & Direct Communications
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /consignment_applications/{appId} {
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny([
          'sellerType',
          'dealerId',
          'dealerSnapshot',
          'dealerDocFee',
          'taxHandling',
          'taxDisclaimerVersion',
          'verifiedAt',
          'verifierUid',
          'verificationStatus',
          'verificationMethod',
          'verificationExpiresAt',
          'verificationRecordVersion',
          'reviewedAt',
          'reviewedBy',
          'convertedAuctionId',
          'updatedAt',
          'registeredUserId',
          'isRegisteredUser',
          'registeredUserRole'
        ])
      );
      allow read: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        resource.data.sellerEmail == request.auth.token.email.lower()
      );
      allow update, delete: if isAdmin();
    }

    match /consignments/{consignmentId} {
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny([
          'sellerType',
          'dealerId',
          'dealerSnapshot',
          'dealerDocFee',
          'taxHandling',
          'taxDisclaimerVersion',
          'verifiedAt',
          'verifierUid',
          'verificationStatus',
          'verificationMethod',
          'verificationExpiresAt',
          'verificationRecordVersion',
          'reviewedAt',
          'reviewedBy',
          'convertedAuctionId',
          'updatedAt',
          'registeredUserId',
          'isRegisteredUser',
          'registeredUserRole'
        ])
      );
      allow read: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        resource.data.sellerEmail == request.auth.token.email.lower()
      );
      allow update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // Outbox Queues
    match /mail/{mailId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /emails/{emailId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /emailLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}