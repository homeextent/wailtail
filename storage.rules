rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Trusted backend operations own upload, promotion and deletion. Client
    // authorization must not depend on a second copy of auction ownership.
    match /auctionPublic/{auctionId}/{assetId} {
      allow get: if true;
    }

    // Draft and private application objects require trusted delivery.
    // Legacy access is limited to the two individually approved gallery objects
    // until the remaining public media is inventoried and copied at cutover.
    match /auctions/{auctionId}/gallery/{filename} {
      allow get: if
        (auctionId == '1988-porsche-928-c3uyca60' && filename == '1792949925577-tjvc0.jpg') ||
        (auctionId == '2019-ram-rebel-3a0455wx' && filename == '1793403168695-t0pxg.jpg');
    }
  }
}
